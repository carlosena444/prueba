# Servidor
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_manager

# JWT (usa un secreto largo y aleatorio, ej: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# bcrypt (costo del hash; 10-12 recomendado)
BCRYPT_ROUNDS=10
